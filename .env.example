# AnyAnyGame 图灵测试账号（必填，至少一个用户名 + 密码）
TT_USERNAME=your-username
TT_NICKNAME=your-nickname
TT_PW=your-password

# 可选配置（默认值见 src/turing_game/models.py）
# TT_BASE_URL=https://www.anyanygame.com
# TT_WS_URL=wss://www.anyanygame.com/api/turing/socket
# TT_SESSION_LOG_DIR=sessions   # 建议显式设置（可填绝对路径），避免写入不确定的启动目录
# TT_OPENING_MESSAGE=你好，刚连上，你等多久了？
# TT_VISITOR_ID=
# TT_CLIENT_VERSION=
# TT_PROTOCOL_VERSION=3
# TT_CHAT_DURATION_SEC=600
# TT_MATCH_TIMEOUT_SEC=30
# TT_ALLOW_RESEARCH=0
# TT_PRIVACY_NOTICE_VERSION=1
# TT_HTTP_TIMEOUT_SEC=20
# TT_WS_OPEN_TIMEOUT_SEC=15
# TT_WS_RECONNECT_MAX_SEC=30
# TT_EVENT_WAIT_SEC=20
# TT_OPENING_GUARD_SEC=12
# TT_MESSAGE_COOLDOWN_SEC=2.5
